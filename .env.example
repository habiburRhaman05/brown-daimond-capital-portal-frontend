# The browser only talks to the backend API (/api/*). No Supabase keys belong here.
#
# PRODUCTION: leave VITE_API_URL UNSET. The app calls same-origin /api and Vercel forwards it to the
# backend (see vercel.json). The session is an HttpOnly cookie, and a browser will not store it for an
# API on a different site (for example my-app.vercel.app -> something.fastapicloud.dev), so setting this
# to a different site breaks sign-in persistence. A production build ignores such a value and warns.
#
# Local development only: call the backend directly instead of through the dev proxy.
# VITE_API_URL=http://localhost:8000

# Dev only: where `npm run dev` proxies /api when VITE_API_URL is unset (default http://localhost:8000)
# VITE_API_TARGET=http://localhost:8000
