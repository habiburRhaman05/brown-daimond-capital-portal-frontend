# The browser only talks to the backend API (/api/*). No Supabase keys belong here.
#
# Production (set in Vercel -> Settings -> Environment Variables, then redeploy):
#   VITE_API_URL=https://your-backend.example.com
# Leave it unset to call same-origin /api (dev proxy / Vercel rewrite).
# VITE_API_URL=

# Dev only: where `npm run dev` proxies /api when VITE_API_URL is unset (default http://localhost:3000)
# VITE_API_TARGET=http://localhost:3000
